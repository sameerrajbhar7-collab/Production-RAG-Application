# ========================================================
# Production Company RAG Assistant - Environment Config
# ========================================================

# 1. Company Identity & Branding
COMPANY_NAME="Acme Global Corporation"
COMPANY_ROLE="Internal AI Knowledge Assistant for Company Policies and Procedures"
RESPONSE_STYLE="professional, accurate, structured, and strictly grounded in company documentation"

# 2. OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
MAX_TOKENS=1500

# 3. Redis Cache & Conversation Memory (Cost Optimization)
# Set to your Redis host (e.g. redis://localhost:6379/0 or redis://redis:6379/0 in Docker)
# If Redis is unavailable, the application gracefully uses an in-memory thread-safe cache
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=true
CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.92
MAX_MEMORY_TURNS=8

# 4. Storage & Retrieval Settings
MAX_FILE_SIZE_MB=16
TOP_K_RETRIEVAL=4
MIN_CONFIDENCE_SCORE=0.35
SECRET_KEY=production_rag_super_secret_key_change_in_prod
